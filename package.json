{
  "name": "batterybloom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BatteryBloom - calm battery health, charging alerts, and power guidance",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
